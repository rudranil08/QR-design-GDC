# QR Designer Environment Variables Template
# ---------------------------------------------
# Security Rule: In Vite, only variables prefixed with VITE_ are exposed
# to the client-side bundle. Never put secret keys (API secrets, private keys)
# in variables starting with VITE_.

# Application Configuration (Client-safe)
VITE_APP_NAME="QR Designer"
VITE_APP_VERSION="1.0.0"
VITE_APP_ENV="development"
